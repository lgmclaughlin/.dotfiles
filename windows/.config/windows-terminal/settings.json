    [
        {
            "id": "Terminal.OpenNewTab",
            "keys": "alt+shift+n"
        },
        {
            "id": "User.newTab.B02E1036",
            "keys": "alt+shift+m"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "alt+shift+l"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "alt+shift+h"
        },
        {
            "id": "Terminal.MoveTabBackward",
            "keys": "alt+shift+["
        },
        {
            "id": "User.closeTab.0",
            "keys": "alt+shift+c"
        },
        {
            "id": "Terminal.MoveTabForward",
            "keys": "alt+shift+]"
        }
    ],
